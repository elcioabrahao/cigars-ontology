<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:ns1="http://qudt.org/schema/qudt/"
  xmlns:om="https://open-metadata.org/ontology/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#">
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/A%20Size">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>A</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>Among the largest standard cigar sizes, traditionally 9.25 inches by a 47 ring gauge; 'A' cigars can burn for as much as two hours.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>A Size</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.A Size</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Accordion%20Method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A rolling method in which the leaves are folded in a zig-zag shape like an accordion's bellows; faster than entubado, slower than booking.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Accordion Method</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Accordion Method</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Active%20Humidification%20System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>An electric or battery-powered device that expels and circulates humidity; typically used in larger humidors or cabinets.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Active Humidification System</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Active Humidification System</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Aging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Ageing</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The process of allowing tobacco to rest under precisely monitored conditions whereby unwanted impurities dissipate; applied to whole leaves in bales and to finished cigars, for months or several years.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Aging</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Bloom"/>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Aging</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Bloom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Aging%20Room">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Ageing Room</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The room in a cigar factory where rolled cigars are stored and allowed to rest so the tobaccos merge flavors; often made of Spanish cedar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Aging Room</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Escaparates"/>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Aging Room</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Escaparates"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Aging.months">
    <ns1:unit>month</ns1:unit>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Duration of aging, in months.</rdfs:comment>
    <rdfs:domain rdf:resource="http://localhost:8000/ontology/cigars/Aging"/>
    <rdfs:label>months</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Amarillo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>A yellow cigar wrapper.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Amarillo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Amarillo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ammonia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Present in freshly harvested tobacco leaves; proper curing and fermentation rid the leaves of it, and improperly aged cigars deliver a harsh, bitter taste from it.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ammonia</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Ammonia</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Arapiraca">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A tobacco with dark, oily leaves grown in the northeastern coastal region of Brazil; its seeds are also grown in Ecuador.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q626175"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Arapiraca</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Arapiraca</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Aroma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>bouquet</skos:altLabel>
    <skos:altLabel>room note</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The scent of a cigar, lit or unlit, as perceived by the olfactory senses.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Aroma</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Aroma</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Aroma%20Wheel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A categorization tool used to describe and identify the different scents and flavor nuances in cigars, ranging from woody and spicy to floral and sweet.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Aroma Wheel</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Aroma Wheel</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Stack</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The burnt end of a lit cigar; its color (white, grey, black) reflects soil minerals such as magnesium.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ash</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Ash</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A compressed, wrapped unit of storage for cured and fermented tobacco — often 100 pounds or more, aged for years or even decades.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bale</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Bale</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Band">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>anilla</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The often colorful ring of paper around the head of a cigar identifying the brand and country of origin, often with intricate lithography.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Band</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Band</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Belicoso">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar shape similar to a Torpedo but shorter, with a more abrupt taper at the head.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Belicoso</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Belicoso</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bethune">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A recipe of herbs, wine, rum, or liqueurs used to infuse tobaccos.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bethune</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Bethune</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Binder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>banda</skos:altLabel>
    <skos:altLabel>capote</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The leaf that holds the filler leaves together inside a cigar; often a wrapper-grade leaf downgraded for cosmetic imperfections; with the filler it forms the bunch.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Binder</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Binder</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bleeding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>purging (lighter)</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Releasing an unwanted pocket of air from a butane lighter's fuel tank so a full injection of fresh fuel can occupy it; also called purging a lighter.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bleeding</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Bleeding</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bleeding%20the%20Lighter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The practice of releasing trapped air and old butane from a jet-flame lighter before refilling, to ensure a cleaner, more efficient flame.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bleeding the Lighter</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Bleeding the Lighter</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Blend">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Blending</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The complete recipe of tobaccos in a premium cigar: up to five filler leaves, one or two binder leaves, and the exterior wrapper; precise ingredients are rarely revealed.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Blend</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Ligero"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Blend</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Ligero"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Blind%20Taste">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The process of smoking a cigar after its band has been removed, with no knowledge of the brand or blend.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Blind Taste</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Blind Taste</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bloom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>plume</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Harmless small white powdery dots, from crystallized natural oils, that appear on an aging cigar's wrapper — a sign of proper aging; not to be confused with harmful blue/green mold.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bloom</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Aging"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Bloom</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Aging"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Blowout%20Bin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The clearance aisle or shelf, physical or online, for cigars marked down to the lowest possible prices; a buzz word for bargain hunters.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Blowout Bin</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Blowout Bin</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Blue%20Mold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>An airborne fungus (peronospora tabacina) that can infect and ruin an entire tobacco field in days; it has impacted every major growing region.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Blue Mold</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Blue Mold</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bofeton">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The layer of paper or film that folds protectively over the cigars inside a dress box, typically featuring the brand's logo.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bofeton</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Bofeton</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Boite%20Nature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The formally styled cedar cigar box: two hinges, a clasp, dovetailed joints, and four lifted cedar collars forming an inner lip.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Boite Nature</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Boite Nature</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bonao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>An agricultural region of the Dominican Republic, roughly an hour from Santiago, where Fuente Fuente Opus X's Cuban-seed shade tobaccos were first harvested.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2306136"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bonao</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Bonao</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Booking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A rolling method in which filler leaves are layered on top of one another like pages of a book and rolled up in a scroll; quick, but can create draw issues.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Booking</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Booking</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Boutique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A term once used for small-batch releases from makers outside the mainstream; overuse has eroded it as a romantic classification.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Boutique</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Boutique</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Box">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The traditional cigar package, widely credited to H. Upmann in the early 1800s; US law since 1865 requires wooden boxes in counts of 25, 50, 100, or 250; Spanish cedar is the most common material.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Box</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Box</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Box%20Aging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Aging cigars in the original box in which they are packaged, which can exhibit distinctively uniform qualities of taste and aroma.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Box Aging</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cabinet%20Selection"/>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Box Aging</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cabinet%20Selection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Box%20Code">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <rdfs:subClassOf rdf:nodeID="b3"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A code, found predominantly on the bottom of Cuban boxes, used to identify the age of the cigars; uncommon outside Cuba.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Box Code</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Box Code</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Box%20Code.code">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment>The factory box code printed on the box.</rdfs:comment>
    <rdfs:domain rdf:resource="http://localhost:8000/ontology/cigars/Box%20Code"/>
    <rdfs:label>code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Box%20Pressed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar with a flat, somewhat squared shape resulting from tight packing in a box with a flat top; degrees vary.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Box Pressed</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Box Pressed</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Brooch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The clasp that fastens the top of a cigar box lid to the bottom.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Brooch</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Brooch</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Brother%20Of%20The%20Leaf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>BOTL</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A popular contemporary term identifying a fellow cigar lover; usage has blossomed across the Internet.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Brother Of The Leaf</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Brother Of The Leaf</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Buckeye">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A small US cigar factory from before the Cuban Revolution; the term originates from Ohio-grown tobacco, the Buckeye State.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Buckeye</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Buckeye</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bunch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>bonche</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The combination of binder and filler leaves, placed in a mold and then finished with a wrapper leaf.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bunch</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Bunch</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Buncher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>boncheros</skos:altLabel>
    <skos:altLabel>bunchers</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The factory worker who specializes in assembling the binder and filler leaves; distinct from the roller in many factories.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Buncher</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Buncher</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bunching">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The process of grouping and rolling the filler leaves into a bunch before it is wrapped with the binder and wrapper.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bunching</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Draw"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Plugged"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Bunching</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Draw"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Plugged"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bunching%20Machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Lieberman</skos:altLabel>
    <skos:altLabel>Temsco</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A hand-powered machine with a leather pad, guides, and a metal lever that aids assembly of the bunch; common in the Dominican Republic, rare elsewhere, unknown in Cuba.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bunching Machine</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Bunching Machine</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Bundle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>Cigars packaged wrapped in cellophane instead of boxes, commonly in counts of 20 or 25; once for un-banded seconds, now also an economy premium format.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Bundle</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Bundle</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Butane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A clean-burning, odorless fuel preferred for cigar lighters; fuel refined at least five times is strongly recommended.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Butane</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Butane</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cabinet%20Selection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A packaging style of 25 or 50 cigars in Spanish cedar boxes, bound with a ribbon inside; the extra air between cigars is believed to facilitate aging.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cabinet Selection</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Box%20Aging"/>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Cabinet Selection</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Box%20Aging"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Calfrisa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A climate-controlled curing barn delivering precise humidity and temperature through interior ductwork; uncommon due to expense and construction.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Calfrisa</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Calfrisa</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cameroon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A West African nation well-known for producing a sought-after wrapper varietal; the term also classifies tobacco grown in the neighboring Central African Republic.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1009"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cameroon</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Tooth"/>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Cameroon</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Tooth"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Candela">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>AMS</skos:altLabel>
    <skos:altLabel>American Market Selection</skos:altLabel>
    <skos:altLabel>Double Claro</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>A green wrapper leaf produced by harvesting before full maturity and fire-curing quickly to lock in chlorophyll; known for mild, grassy, and sweet flavors.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Candela</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Curing"/>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Candela</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Curing"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Canoeing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A burn defect where one portion of the cigar burns hotter and faster than the other; sometimes remedied by touching up the burn with a lighter.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Canoeing</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Canoeing</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The small leaf that covers and secures the head of the cigar; it must be cut or removed before smoking.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cap</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cold%20Draw"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cutter"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Flag%20Tip"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Gum"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Triple%20Cap"/>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Cap</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cold%20Draw"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cutter"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Flag%20Tip"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Gum"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Triple%20Cap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Carbon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Charcoal (Spanish) used to raise the temperature in tobacco-curing barns; many operations now use propane heaters.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Carbon</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Carbon</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Carotene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A plant pigment that replaces chlorophyll in tobacco as the chlorophyll naturally breaks down.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Carotene</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Carotene</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Casing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>case</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Re-moisturizing aged tobacco so it can be worked with, by dipping in water, misting, or high-humidity storage; also a term for flavoring pipe tobacco.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Casing</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Casing</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cedar%20Spill">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>spill</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A long, thin strip of cedar that is lit and then used to light a cigar, transferring no impurities from fuel or matches.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cedar Spill</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Wooden%20Match"/>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Cedar Spill</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Wooden%20Match"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cellophane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The thin, clear protective sleeve around individual cigars; safeguards packaging, transport, and retail handling, and inhibits humidity loss.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cellophane</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Humidor"/>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Cellophane</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Humidor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Chaveta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The flat piece of steel with a curved end that a cigar roller uses to trim a wrapper leaf to the correct size.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Chaveta</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Chaveta</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cheesecloth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The material once used to cover shade-grown tobacco fields; today replaced by nylon.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cheesecloth</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Cheesecloth</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cheroot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A rustic, often inexpensive cigar with an open foot and an open head; associated with Spaghetti Westerns.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cheroot</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Cheroot</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Chinchal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>Slang for a small cigar factory or shop.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Chinchal</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Chinchal</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Churchill">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A classic cigar shape measuring 7 inches by a 47 ring gauge, named for Sir Winston Churchill, history's most famous cigar smoker.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Churchill</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Churchill</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cibao%20Valley">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>The Dominican valley in which much of the country's premium tobacco is planted.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q135916712"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cibao Valley</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Cibao Valley</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Anatomy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:definition>The physical parts of a cigar and their roles: filler, binder, wrapper, cap, head, foot, and shoulder.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
