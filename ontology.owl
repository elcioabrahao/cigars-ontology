  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Volado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The filler priming near the bottom of the plant, under Seco; milder than Ligero and valued for its burning properties.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Volado</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Volado</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Vuelta%20Abajo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A valley in western Cuba prized for the quality of tobacco grown there.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q739259"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Vuelta Abajo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Vuelta Abajo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Wheel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>rueda</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A bundle of 100 cigars, typically bound by a ribbon.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Wheel</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Wheel</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Wilting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>Laying stalk-cut tobacco on the ground to wilt in the sun after harvest.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Wilting</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Wilting</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Wooden%20Match">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The best match for lighting a cigar: a long cedar match.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Wooden Match</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cedar%20Spill"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Wooden Match</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cedar%20Spill"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Wrapper">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>capa</skos:altLabel>
    <skos:altLabel>cover leaf</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The outermost and highest-quality leaf of a premium cigar; the most expensive leaf, ideally free of veins, tears, and cosmetic imperfections.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Wrapper</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Connecticut%20Shade"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Shade%20Grown"/>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Wrapper</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Connecticut%20Shade"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Shade%20Grown"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Wrapper%20Colors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:definition>The color spectrum of wrapper leaves, from Candela through Claro, Colorado, and Maduro to Oscuro.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Amarillo"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Candela"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Claro"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Colorado"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Colorado%20Maduro"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Maduro"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Natural"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Oscuro"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Rosado"/>
    <skos:prefLabel>Wrapper Colors</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <om:fullyQualifiedName>cigars.Wrapper Colors</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Yankee%20Hinge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The long boards on Connecticut River Valley tobacco barns, designed to swing open to increase airflow.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Yankee Hinge</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Yankee Hinge</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
