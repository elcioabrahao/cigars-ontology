  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Association%20of%20America">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>An organization of importers, distributors, and manufacturers of cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Association of America</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cigar Association of America</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Bar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A bar or lounge where cigar smoking is permitted.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Bar</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cigar Bar</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Boom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The period of tremendous growth in the premium cigar industry from the early to late 1990s, when demand quadrupled from 100 million to over 400 million cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Boom</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cigar Boom</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Box%20Tool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The simple tool used to break cigar box seals in retail shops, removing the nail that seals a flat-top box and pounding it back in.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Box Tool</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cigar Box Tool</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Case">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A case designed to protect cigars during travel or transport, ranging from pocket sizes holding one to three cigars to larger models storing ten or more.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Case</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cigar Case</om:fullyQualifiedName>
  </rdf:Description>
