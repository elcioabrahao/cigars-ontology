    <ns1:unit>1/64 inch</ns1:unit>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Ring gauge of the vitola, in 64ths of an inch.</rdfs:comment>
    <rdfs:domain rdf:resource="http://localhost:8000/ontology/cigars/Vitola"/>
    <rdfs:label>ringGauge</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
