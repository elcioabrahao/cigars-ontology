  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Rights%20of%20America">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>An organization established in 2008 by cigar companies, retailers, and consumers to promote and protect the rights of premium cigar lovers.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Rights of America</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cigar Rights of America</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigar%20Rolling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The artisanal process of handcrafting a cigar: carefully arranging filler, binder, and wrapper leaves to ensure optimal construction and draw.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigar Rolling</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Cigar Rolling</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cigarillo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A small, thin, quick-burning machine-made cigar, usually of dry-cured short-filler tobacco, packaged in counts of ten or twenty.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cigarillo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Cigarillo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Claro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>A pale wrapper leaf, from a light, faded green hue to a light tan.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Claro</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Claro</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Clear%20Havana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A cigar manufactured in the US prior to the Cuban Embargo, made with Cuban tobacco.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Clear Havana</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Clear Havana</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Closeout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A discontinued brand or blend that will no longer be made, removed from the market quickly at dramatically lowered prices.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Closeout</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Closeout</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Coffin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>An individual box for a single cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Coffin</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Coffin</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cold%20Draw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>cold taste</skos:altLabel>
    <skos:altLabel>dry draw</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Taking a draw on a cut but unlit cigar to preview its flavors before lighting.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cold Draw</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Cold Draw</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Collars">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The Spanish cedar slats that line the interior edges of a cigar box and form an inner lip.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Collars</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Collars</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Color%20Sorting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>escogida</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>Among the last steps of production: trained workers examine each cigar against a stark black or white surface so every box exhibits a uniform color.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Color Sorting</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Color Sorting</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Colorado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Rojizo</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>A brown or reddish-brown color classification of wrapper leaves.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Colorado</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Colorado</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Colorado%20Maduro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>A wrapper shade darker than Colorado and lighter than Maduro, combining strength and sweetness with a typically richer taste.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Colorado Maduro</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Colorado Maduro</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Combustion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The rate and efficiency at which a cigar burns, influenced by humidity, the tobacco blend, and construction.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Combustion</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Combustion</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Complexity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The condition of taste when a cigar produces multiple transitions of flavor.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Complexity</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Complexity</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Condega">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>One of Nicaragua's three key tobacco-growing regions, just north of Esteli, known for medium-bodied, rich tobacco.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1012589"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Condega</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Condega</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Connecticut%20Broadleaf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A primary wrapper leaf grown in the Connecticut River Valley under direct sunlight, almost always processed as Maduro and harvested by stalk cutting.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Connecticut Broadleaf</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Connecticut Broadleaf</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Connecticut%20Habano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A rare Cuban-seed wrapper grown in the Connecticut River Valley, known for its rich, leathery taste.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Connecticut Habano</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Connecticut Habano</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Connecticut%20River%20Valley">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Connecticut</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>The primary tobacco-growing region of the US, from Hartford through Massachusetts; its fertile soils and growing techniques produce prized wrapper tobacco.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q108574278"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Connecticut River Valley</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Connecticut River Valley</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Connecticut%20Shade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A silky, golden-blond wrapper grown under shade in the Connecticut River Valley, prized for its creamy, rich flavor.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Connecticut Shade</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Wrapper"/>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Connecticut Shade</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Wrapper"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Corojo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>The most prominent variety of Cuban-seed tobacco today, first introduced in the 1930s and now grown throughout Central America; no longer grown in Cuba due to disease susceptibility.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5172088"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Corojo</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Shade%20Grown"/>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Corojo</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Shade%20Grown"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Corona">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A classic cigar size, typically 5 5/8 inches by a 42 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Corona</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Corona</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Corona%20Gorda">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A 'fat' Corona, typically with a ring gauge over 50, approximating a traditional Toro in size.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Corona Gorda</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Corona Gorda</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Costero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The sides of a cigar box that bear the brand's name, logo, and other visual elements.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Costero</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Costero</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cuban%20Seed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>Tobaccos grown outside Cuba from seed varietals that originated there; Ecuador is a prominent region for Cuban-seed wrappers.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cuban Seed</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Cuban Seed</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cubatabaco">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The government-owned enterprise that controls all of Cuba's cigar brands.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cubatabaco</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Cubatabaco</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cubierta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The outer lid or top of a cigar box.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cubierta</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Cubierta</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cuje">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>lathe</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The wooden pole in a curing barn from which freshly harvested tobacco leaves hang; cuje cortos run about six feet, cuje largos twelve.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cuje</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Cuje</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Culebra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>Spanish for 'snake': three Panetelas (often 6 x 38) braided together and meant to be smoked individually; one origin theory is factory inventory control for rollers.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Culebra</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Culebra</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Curing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The process of gradually removing moisture from tobacco leaves after harvest, taking place in curing barns over roughly 45 days.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Curing</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Candela"/>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Curing</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Candela"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Curing%20Barn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>casa de tabaco</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The structure where harvested tobacco is stored and dried gradually for roughly 45 days; temperature and humidity determine the curing time.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Curing Barn</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Curing Barn</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:definition>Post-harvest processing of tobacco leaves: curing, fermentation, and ageing.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Aging"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Aging%20Room"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Ammonia"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Bale"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Box%20Aging"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Calfrisa"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Carbon"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Carotene"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Casing"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Cuje"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Curing"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Curing%20Barn"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Doghouse"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Empilonando"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Ensarte"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Fermentation"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Firemen"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Hand"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Microfermentation"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Mulling"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Pilon"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Quisqueya"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Sarta"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Tercios"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Yankee%20Hinge"/>
    <skos:prefLabel>Curing and Fermentation</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <om:fullyQualifiedName>cigars.Curing and Fermentation</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Cutter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A tool used to clip or open the cap of a cigar so air can pass; the three most common are the straight (guillotine), punch (bullet), and V (cat's eye) cutters.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Cutter</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Cutter</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Destemming">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>despalillo</skos:altLabel>
    <skos:altLabel>stemming</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>Removing the thick stems from tobacco leaves so they can be rolled: the entire stem for binder and wrapper leaves, the bottom two-thirds for filler.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Destemming</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Destemming</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Diadema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A large Figurado, usually at least 8 inches long, with a tapered head and closed foot; a common Diadema is the Salomon.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Diadema</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Diadema</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Dipping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Dipping the head of a cigar into a drink, typically a darker spirit; often disapproved of by purists.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Dipping</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Dipping</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Doghouse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The top vent or opening of a tobacco curing barn where heat escapes and air flows.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Doghouse</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Doghouse</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Dominican%20Republic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A nation regarded as one of the primary producers of premium cigars in the world; Santiago and La Romana account for much of its production.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q786"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Dominican Republic</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Dominican Republic</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Double%20Corona">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A long cigar size, typically 7.5 inches by a 49 to 52 ring gauge, providing an extended, cooler burn.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Double Corona</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Double Corona</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Draw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The process of pulling air through a cigar, or the pull itself; a measure of the cigar's construction, affected by the style of cut.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Draw</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Bunching"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Ring%20Gauge"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Draw</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Bunching"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Ring%20Gauge"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Draw%20Test%20Machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A quality-control device that pulls air through a cigar to ensure it is rolled neither too tight nor too loose; widely relied upon since the 1990s.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Draw Test Machine</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Draw Test Machine</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ecuador">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A South American nation whose natural cloud cover and nutrient-rich volcanic soils produce prized wrapper leaves, chiefly outside Guayaquil in the Andes foothills.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q736"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ecuador</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Ecuador</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Eight%20Nine%20Eight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>8-9-8</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A traditional packing of 25 cigars in a box: 8 on the bottom row, 9 in the middle, 8 on top.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Eight Nine Eight</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Eight Nine Eight</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Empilonando">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The process of assembling a pilon or bulk of tobacco for fermentation.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Empilonando</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Empilonando</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Encallado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>A limited form of shading where barriers are erected only on the sides of the crop, protecting from wind and low-angle sun.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Encallado</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Encallado</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ensarte">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The process of transferring harvested tobacco leaves from the fields to the curing barn.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ensarte</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Ensarte</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Entubar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>entubado</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A rolling method in which each filler leaf is rolled into a tube shape to ensure a perfect draw.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Entubar</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Entubar</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Escaparates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The cabinets at a cigar factory where freshly rolled cigars are cooled.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Escaparates</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Aging%20Room"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Escaparates</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Aging%20Room"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Esteli">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Estelí</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q728015"/>
    <skos:definition>The Nicaraguan town around which much of the country's cigar production is situated; its tobacco is the strongest of the three key regions.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Esteli</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Esteli</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Federal%20Excise%20Tax">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The tax levied on cigars imported into the US; the 2009 SCHIP expansion raised it from under 5 cents to 40.26 cents per cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Federal Excise Tax</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Federal Excise Tax</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Fermentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>The process after curing and before aging in which bulks of leaves release ammonia and other impurities under natural heat (up to 140 degrees Fahrenheit) and pressure; can take several months or longer.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Fermentation</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Maduro"/>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Fermentation</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Maduro"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Figurado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>Any non-Parejo cigar shape, such as Torpedos, Belicosos, Pyramids, and Perfectos.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Figurado</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Figurado</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Filler">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>tripa</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The innermost leaves of a cigar, surrounded by the binder; premium handmades use between two and five filler leaves.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Filler</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Primings"/>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Filler</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Primings"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Finish">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The final tasting notes of a cigar, or its residual taste on the palate; lingers longer in stronger cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Finish</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Finish</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Firemen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Workers in curing barns who continually monitor conditions as heat is introduced, to insure no fire starts; temperatures can exceed 150 degrees Fahrenheit.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Firemen</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Firemen</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Firm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A cigar whose draw is too tight or that is rolled too densely.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Firm</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Firm</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Flag%20Tip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>curly head</skos:altLabel>
    <skos:altLabel>pigtail</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A head finish in which the roller extends and twists off the wrapper leaf instead of applying a traditional cap.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Flag Tip</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Flag Tip</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Foil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A decorative and protective wrap, often covering a portion of a cigar, that can also encapsulate flavor as it ages.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Foil</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Foil</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Foot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The end of the cigar that is lit.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Foot</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Toasting"/>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Foot</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Toasting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Glass%20Jar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Amatista jar</skos:altLabel>
    <skos:altLabel>amatista</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A vintage packaging form: heavy glass jars of 25 or 50 cigars, rarely used today.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Glass Jar</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Glass Jar</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Glass%20Top%20Cohibas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A reference to commonly counterfeited Cuban Cohibas: real ones are never packaged in boxes with a clear window displaying the cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Glass Top Cohibas</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Glass Top Cohibas</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Gorda">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Gordo</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>Spanish for 'fat'; a reference to thicker cigar shapes.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Gorda</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Gorda</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Gordito">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A Cuban cigar size measuring 5.5 inches by a 50 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Gordito</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Gordito</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Gran%20Corona">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A very long cigar size, typically 9.25 inches by a 47 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Gran Corona</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Gran Corona</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Guajiro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A complimentary Cuban term for a farmer or man of the earth.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Guajiro</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Guajiro</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Guayabera">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A traditional Cuban dress shirt lined with many front pockets, worn untucked.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Guayabera</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Guayabera</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Guillotine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>straight cutter</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A straight cutter that clips the cap off the head of a cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Guillotine</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Guillotine</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Gum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A tasteless, odorless substance used to apply the head of the wrapper leaf around the bunch in a handmade cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Gum</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Gum</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Habano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>Another term for a Cuban cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Habano</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Habano</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Habanos%20SA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Habanos S.A.</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The company in charge of global distribution for Cuban cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Habanos SA</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Habanos SA</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Half%20Wheel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>media rueda</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A bundle of 50 cigars, traditionally tied with a ribbon.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Half Wheel</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Half Wheel</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Hand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Roughly 30 to 40 tobacco leaves tied together during the curing process; several hands are assembled into a bulk for fermentation.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Hand</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Hand</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Hand%20Rolled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>hand-rolled</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A cigar made entirely by hand from premium long-filler tobaccos finished with a wrapper leaf.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Hand Rolled</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Hand Rolled</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Havana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Habana</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>The capital of Cuba; also a term often used to refer to Cuban cigars.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1563"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Havana</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Havana</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Head">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The end of the cigar that goes in the mouth, enclosed by the cap.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Head</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Head</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Homogenized%20Tobacco%20Leaf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>HTL</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A sheet of chopped tobacco scraps and cellulose adhesive, cut up for use in cheap machine-made cigars; never used in premium handmade cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Homogenized Tobacco Leaf</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Homogenized Tobacco Leaf</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Honduras">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>The fourth largest cigar-producing nation, behind Nicaragua, the Dominican Republic, and Cuba.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q783"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Honduras</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Honduras</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Hot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Burning too fast or hot, typically of cigars rolled too loosely or under-filled.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Hot</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Hot</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Humidification%20Element">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>humidification unit</skos:altLabel>
    <skos:altLabel>reservoir</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The humidity source inside a humidor — traditionally floral foam in a vented plastic or metal case — replenished with distilled water or propylene glycol.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Humidification Element</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Humidification Element</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Humidor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <rdfs:subClassOf rdf:nodeID="b1"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A box for storing cigars, often of Spanish cedar with a tight seal maintaining 65-70% relative humidity; also the room in a cigar shop where cigars are stored and displayed.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Humidor</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cellophane"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Spanish%20Cedar"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Humidor</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cellophane"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Spanish%20Cedar"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Humidor.capacity">
    <ns1:unit>cigars</ns1:unit>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Number of cigars the humidor holds.</rdfs:comment>
    <rdfs:domain rdf:resource="http://localhost:8000/ontology/cigars/Humidor"/>
    <rdfs:label>capacity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Hybrid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>A tobacco varietal developed by crossing two or more plant types, engineered for disease resistance, greater yields, or specific flavor profiles.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Hybrid</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Hybrid</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Hygrometer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The device in a humidor that measures the humidity level; analog dial models persist alongside digital ones that also read temperature.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Hygrometer</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Hygrometer</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/IPCPR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>International Premium Cigar &amp; Pipe Retailers Association</skos:altLabel>
    <skos:altLabel>RTDA</skos:altLabel>
    <skos:altLabel>Retail Tobacco Dealers of America</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The International Premium Cigar &amp; Pipe Retailers Association, formerly the Retail Tobacco Dealers of America: a US trade organization of premium tobacco retailers.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>IPCPR</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.IPCPR</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/ISOM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>Slang for Cuba: the Island South of Miami.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>ISOM</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.ISOM</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Inhale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Drawing smoke into the lungs or diaphragm; common among cigarette smokers but never attempted with cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Inhale</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Inhale</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Jalapa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>One of Nicaragua's three key tobacco-growing regions; its refined tobacco is often used as wrapper and is the least intense of the three.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2395471"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Jalapa</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Jalapa</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Jamastran">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Jamastrán</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A key tobacco-growing valley in Honduras, near Danli.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Jamastran</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Jamastran</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/La%20Casa%20Del%20Habano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>Cigar shops that sell Cuban cigars and are partially owned by Habanos S.A.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>La Casa Del Habano</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.La Casa Del Habano</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Lancero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A long, narrow cigar size, traditionally 7 to 7.5 inches by a 38 ring gauge, noted for concentrated flavor.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Lancero</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Lancero</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Larguero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The front side of a cigar box where the brand name, logo, and decorative elements appear.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Larguero</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Larguero</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Lector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A person who reads to the cigar rollers while they make cigars; an uncommon practice today that survives in Cuba; the Montecristo brand traces its name to a lector's reading.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Lector</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Lector</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Libre%20de%20Pie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>sand leaf</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The small leaves at the base of the tobacco plant; typically discarded.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Libre de Pie</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Libre de Pie</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ligero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The topmost filler priming; the thickest, heartiest, and strongest leaves because they receive the most sunlight.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ligero</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Blend"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Nicotine%20Strength"/>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Ligero</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Blend"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Nicotine%20Strength"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Lighter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A device for lighting cigars; butane models are preferred because refined butane exhibits fewer impurities and will not taint flavor.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Lighter</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Lighter</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Lighter%20Fluid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Liquid fuel used in wick lighters; not recommended for cigars because it is unrefined and can taint the flavor.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Lighter Fluid</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Lighter Fluid</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Long%20Filler">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>Whole-leaf tobacco used in premium handmade cigars, as opposed to chopped short-filler; called tripa in Spanish.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Long Filler</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Long Filler</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Lonsdale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar shape measuring 6 to 7 inches by a 42 to 44 ring gauge; longer than a Corona, not as thin as a Panetela.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Lonsdale</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Lonsdale</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Loose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>underfilled</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A cigar that is under-filled, so too much air passes on the draw; burns hot and fast.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Loose</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Loose</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Machine%20Made">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>mass-market</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>Cigars made by machine rather than by hand, using short-filler and homogenized tobacco; manufactured in far greater quantities than premium cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Machine Made</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Machine Made</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Maduro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>Spanish for 'ripe': a very dark brown or nearly black wrapper, achieved through sun exposure or extended fermentation that brings sugars to the leaf surface.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Maduro</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Fermentation"/>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Maduro</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Fermentation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Mata%20Fina">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A prized Brazilian wrapper leaf harvested near the Recôncavo region of the northeastern coast.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Mata Fina</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Mata Fina</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Medio%20Tiempo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The small leaves that grow at the very top of the plant; prized by cigar-makers for complex, intense flavor from maximum direct sunlight.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Medio Tiempo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Medio Tiempo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Microfermentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A specialized ageing process applied to small batches of tobacco to enhance complexity and smoothness.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Microfermentation</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Microfermentation</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Mixed%20Filler">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Cuban sandwich</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A handmade cigar using a combination of long-filler and short-filler tobaccos.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Mixed Filler</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Mixed Filler</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Mold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The two-part wood or plastic form, joined under pressure, that conforms the bunch to the cigar shape being made; the word also names the harmful blue or green fungus that develops on cigars stored too warm — such cigars must be discarded.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Mold</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Mold</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Mulling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>An additional fermentation step for tobacco from the periphery of a pilon, exposed to about 100 degrees Fahrenheit and 90% RH in a mulling room for a more complete fermentation.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Mulling</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Mulling</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Multi%20Origin%20Blend">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Multi-Origin Blend</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A cigar blend that incorporates tobaccos from different countries, offering a diverse and layered smoking experience; the counterpart of a Puro.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Multi Origin Blend</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Puro"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Multi Origin Blend</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Puro"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Natural">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Colorado Claro</skos:altLabel>
    <skos:altLabel>EMS</skos:altLabel>
    <skos:altLabel>English Market Selection</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>A light-brown or golden-blond to medium-brown wrapper color; the modern term for what was once called English Market Selection or Colorado Claro; classic on Connecticut Shade.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Natural</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Natural</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Nicaragua">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>One of the world's most prominent cigar-producing and tobacco-growing nations; its three key regions are Esteli, Jalapa, and Condega, with production centered around Esteli.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q811"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Nicaragua</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Nicaragua</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Nicotiana%20Tabacum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>cultivated tobacco</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The most common plant of the genus Nicotiana, from which contemporary commercially grown tobacco derives; found only in cultivation.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q181095"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Nicotiana Tabacum</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Nicotiana Tabacum</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Nicotine%20Strength">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The amount of nicotine present in a cigar, influenced by the type and priming of the tobacco leaves used.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Nicotine Strength</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Ligero"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Nicotine Strength</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Ligero"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Nosing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>retronasal olfaction</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Pushing cigar smoke out through the nose, producing added layers of perceived flavor and aroma.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Nosing</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Nosing</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Oil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The desirable oily sheen on a wrapper leaf, a sign of adequate humidification; more common on dark wrappers such as Maduro and Oscuro.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Oil</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Oil</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Olor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A tobacco varietal grown in the Dominican Republic, used predominantly as binder and filler and known for its large leaves.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Olor</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Olor</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ometepe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A volcanic island near Lake Nicaragua whose fertile volcanic soils yield tobacco with a distinctive sweet, earthy taste.</skos:definition>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q950875"/>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ometepe</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Ometepe</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Oscuro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Double Maduro</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>The darkest color of wrapper leaf, darker than Maduro, associated with pronounced intensity.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Oscuro</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Sun%20Grown"/>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Oscuro</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Sun%20Grown"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Panetela">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Panatela</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A long, slender cigar shape, typically 5 to 7 inches by a 34 to 38 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Panetela</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Panetela</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Papeleta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A rectangular or oval sticker on the top of a cigar box, wrapping around to the bottom, that must be sliced to open the lid.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Papeleta</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Papeleta</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Parejo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <owl:disjointWith rdf:resource="http://localhost:8000/ontology/cigars/Figurado"/>
    <skos:altLabel>Parejos</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar with straight, parallel sides, such as a traditional Robusto, Churchill, Toro, or Corona.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Parejo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Parejo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Partido">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A region in Cuba where premium tobacco is grown.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Partido</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Partido</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Passive%20Humidification%20System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A humidification system that needs no batteries or electricity, such as traditional floral-foam units or Boveda packs.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Passive Humidification System</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Passive Humidification System</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pelletized">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>Coated in a neutral material such as clay to make tiny tobacco seeds easier to handle.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pelletized</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Pelletized</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pelo%20D%20Oro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Pelo d'Oro</skos:altLabel>
    <skos:altLabel>Pelo de Oro</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>Spanish for 'hair of gold': a tobacco prized for its rich, distinctive flavor; grown in Nicaragua and other regions but uncommon due to disease susceptibility.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pelo D Oro</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Pelo D Oro</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Perfecto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar shape that tapers at both ends; all Perfectos are Figurados, but not all Figurados are Perfectos.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Perfecto</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Perfecto</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Petit%20Corona">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A smaller version of the Corona, approximately 4.5 to 5 inches by a 38 to 42 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Petit Corona</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Petit Corona</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Piercer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>lance</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A cutter with a sharp needle-like point that penetrates the cap to create airflow; can sometimes remedy a plugged cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Piercer</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Piercer</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pilon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>bulk</skos:altLabel>
    <skos:altLabel>burro</skos:altLabel>
    <skos:altLabel>pilón</skos:altLabel>
    <skos:altLabel>trojes</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A large pile (up to 4,000 pounds or more) of cured tobacco leaves assembled for fermentation; dismantled and reassembled several times over months.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pilon</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Pilon</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Piloto%20Cubano">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Piloto</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A famous varietal of Cuban-seed tobacco grown in the Dominican Republic.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Piloto Cubano</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Piloto Cubano</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pinar%20del%20Rio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A world-famous tobacco-growing region in western Cuba where the country's most legendary and prized tobacco is grown.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pinar del Rio</skos:prefLabel>
    <skos:relatedMatch rdf:resource="http://www.wikidata.org/entity/Q115497"/>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Pinar del Rio</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Plugged">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Plug</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Having an obstructed draw; a piercer can sometimes loosen the tobacco, otherwise the cigar is unsmokable.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Plugged</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Bunching"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Plugged</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Bunching"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pre%20Castro%20Cigar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Pre-Castro</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A Cuban cigar manufactured prior to Fidel Castro's ascent to power in January 1959.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pre Castro Cigar</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Pre Castro Cigar</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pre%20Embargo%20Cigar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Pre-Embargo</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A Cuban cigar manufactured before the enactment of the US trade embargo against Cuba in 1962.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pre Embargo Cigar</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Pre Embargo Cigar</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Press">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A device used to compress cigar molds after bunching (hand-powered or pneumatic) or to compress tobacco bales after fermentation (hydraulic).</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Press</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Press</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Primings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The vertical stations of a tobacco plant, harvested bottom-up a few leaves at a time; from bottom: Volado, Seco, Viso, Ligero; leaves strengthen with height and sunlight.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Primings</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Filler"/>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Primings</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Filler"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Propylene%20Glycol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>50/50</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A 50/50 solution used to soak humidification units; designed to stop releasing humidity when the humidor reaches 70% RH, so cigars are not oversaturated.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Propylene Glycol</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Propylene Glycol</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Punch%20Cutter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Punch</skos:altLabel>
    <skos:altLabel>bull's eye piercer</skos:altLabel>
    <skos:altLabel>bullet cutter</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A cutter with a circular blade that removes a precise section of the cap, keeping it intact; available in various ring gauges; use with careful, twisting pressure.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Punch Cutter</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Punch Cutter</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Purging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Blowing smoke from the head of a cigar out through the foot to eliminate the buildup of unwanted flavors.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Purging</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Purging</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Puro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>Spanish for 'cigar'; specifically a cigar whose binder, filler, and wrapper tobaccos are all grown in one nation.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Puro</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Multi%20Origin%20Blend"/>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Puro</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Multi%20Origin%20Blend"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Pyramid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar shape that tapers sharply at the head with an open foot; often called a Torpedo.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Pyramid</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Pyramid</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Quisqueya">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A rudimentary structure used to cure tobacco in parts of the Dominican Republic; less protective than a traditional curing barn.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Quisqueya</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Quisqueya</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Regional%20Edition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>Cuban cigars released only in specific regions.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Regional Edition</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Regional Edition</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Ring%20Gauge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>The diameter of a cigar, measured in 64ths of an inch: a 50 ring gauge is 50/64 of an inch thick. Larger ring gauges generally burn cooler and can carry more complex blends.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Ring Gauge</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Draw"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Smoking%20Time"/>
    <om:fullyQualifiedName>cigars.Vitolas.Ring Gauge</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Draw"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Smoking%20Time"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Robusto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>The most popular cigar shape in the world, measuring 4.75 to 5.75 inches by a 48 to 52 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Robusto</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Robusto</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Roller">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>torcedor</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The factory worker who makes the cigar, applying the wrapper leaf to the bunch; in some factories one worker both bunches and rolls.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Roller</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Roller</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Rolling%20Gallery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The area or floor of a cigar factory where rollers craft cigars by hand.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Rolling Gallery</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Rolling Gallery</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Rolling%20Method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>How a cigar is made: booking, the accordion method, or entubado.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Rolling Method</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Rolling Method</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Rolling%20Table">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>The often wooden table where a cigar roller sits to make cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Rolling Table</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Rolling Table</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Rosado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <skos:definition>Spanish for 'rose-colored': Cuban-seed tobaccos exhibiting a reddish-brown color.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Rosado</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Wrapper Colors.Rosado</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/SCHIP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The State Children's Health Care Initiative Program, whose 2009 expansion was funded by the federal excise tax on cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>SCHIP</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.SCHIP</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Salomon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Salomón</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A large, curvaceous Figurado, typically 7.25 inches by a 57 ring gauge at its thickest point, tapered at the head and finished with a nipple at the foot; requires great skill to roll.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Salomon</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Salomon</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/San%20Andres">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>San Andrés</skos:altLabel>
    <skos:altLabel>San Andrés Negro</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A Mexican wrapper leaf named for its growing region, stalk cut and typically dark brown, either oily or dry in texture; prized for rich, spicy, sweet taste.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>San Andres</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.San Andres</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/San%20Vincente">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>A tobacco hybrid grown in the Dominican Republic.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>San Vincente</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.San Vincente</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Santiago">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:definition>The second largest city of the Dominican Republic and the area where most Dominican cigar production takes place.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Santiago</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobaccos and Origins.Santiago</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Sarta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>A string used to bind tobacco leaves together during the curing process.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Sarta</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Sarta</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Scissors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Cigar-cutting scissors with sloping blades designed to embrace the cap of a Parejo without cracking the wrapper; folding models are pocket friendly.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Scissors</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Scissors</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Seco">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The filler priming from the mid-section of the plant; the thinnest and mildest leaf used in the filler.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Seco</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Seco</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Seedbed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>cantero</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The bed where tobacco seedlings sprout; today often trays inside greenhouses, planted in excess as insurance against weather.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Seedbed</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Seedbed</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Seedling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>A young tobacco plant a few inches high, reached roughly 60 days after planting; transferred from tray or seedbed to the field.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Seedling</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Seedling</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Semi%20Boite%20Nature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Semi-Boite Nature</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A plain cedar cigar box with a clasp on the front and two rear hinges.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Semi Boite Nature</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Semi Boite Nature</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Shade%20Grown">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>Wrapper leaf grown under a tent (historically cheesecloth, now nylon) that filters sunlight, producing thinner, more elastic leaves; most associated with Connecticut.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Shade Grown</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Corojo"/>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Wrapper"/>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Shade Grown</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Corojo"/>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Wrapper"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Short%20Filler">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>chop</skos:altLabel>
    <skos:altLabel>chopped-filler</skos:altLabel>
    <skos:altLabel>picadura</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>Chopped-up tobacco scraps used predominantly in cheap machine-made cigars; burns hotter and faster than long filler.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Short Filler</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Production.Short Filler</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Shoulder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The part of a cigar where the body curves to meet the cap; cut above it so the cap stays intact.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Shoulder</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Shoulder</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Single">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The unit of measure for a single cigar, as opposed to a box.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Single</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Single</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Slide%20Lid%20Box">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>cabinet selection box</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A cabinet-selection-style box with a sliding lid, typically containing 25 or 50 ribbon-bound cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Slide Lid Box</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Slide Lid Box</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Small%20Batch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>small-batch</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A cigar made in very small quantities, often due to the rarity of its tobaccos; unlike a limited edition it may be produced annually.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Small Batch</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Small Batch</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Smoke%20Output">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The volume of smoke a cigar produces, which can indicate its construction quality and tobacco blend.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Smoke Output</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Smoke Output</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Smoking%20Temperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The ideal temperature at which a cigar should be enjoyed; overheating produces bitterness and harshness and can lead to tunnelling.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Smoking Temperature</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Smoking Temperature</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Smoking%20Time">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <rdfs:subClassOf rdf:nodeID="b2"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The duration a cigar burns: roughly 30 minutes for a 5x50 Robusto, over an hour for a 7.5x52 Double Corona; thinner cigars burn hotter and faster.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Smoking Time</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Ring%20Gauge"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Smoking Time</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Ring%20Gauge"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Smoking%20Time.minutes">
    <ns1:unit>minute</ns1:unit>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Typical smoking duration, in minutes.</rdfs:comment>
    <rdfs:domain rdf:resource="http://localhost:8000/ontology/cigars/Smoking%20Time"/>
    <rdfs:label>minutes</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Spanish%20Cedar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>cedar</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>Cedrela, a mahogany-family tree harvested in tropical regions; ideal for cigar boxes and humidors because it reacts positively with moisture and benefits aging; also a tasting note.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Spanish Cedar</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Humidor"/>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Spanish Cedar</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Humidor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Stalk%20Cut">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>A harvest method where the whole plant is cut at once rather than priming leaves in succession; associated with Connecticut Broadleaf and San Andrés.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Stalk Cut</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Stalk Cut</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Stogie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>Slang term for a cigar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Stogie</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Stogie</om:fullyQualifiedName>
  </rdf:Description>
