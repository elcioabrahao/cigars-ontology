    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Head"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Oil"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Shoulder"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Tooth"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Vein"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Wrapper"/>
