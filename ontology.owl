    <ns1:unit>inch</ns1:unit>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Length of the vitola, in inches.</rdfs:comment>
    <rdfs:domain rdf:resource="http://localhost:8000/ontology/cigars/Vitola"/>
    <rdfs:label>lengthInches</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
