  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tooth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>Tiny bumps on a cigar's wrapper leaf formed by oil pockets; common on Cameroon wrappers.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tooth</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cameroon"/>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Tooth</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cameroon"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Top%2025">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>Cigar Aficionado's annual Top 25 Cigars of the Year list, announced at the end of the year.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Top 25</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Top 25</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Topping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>desflorado</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>Removing the flowers, seeds, or upper portion of the plant so nutrients are redirected to the leaves, making them stronger and sweeter.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Topping</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Topping</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Torch%20Lighter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A butane lighter producing a concentrated single- or multiple-jet flame; convenient for toasting the foot quickly and performing touch-ups.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Torch Lighter</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Torch Lighter</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Toro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>An extremely popular cigar size measuring 6 to 6.5 inches by a 50 to 54 ring gauge.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Toro</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Toro</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Torpedo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Pirámide</skos:altLabel>
    <skos:altLabel>pyramid</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar shape with a sharply tapering closed head; frequently interchanged with Pyramid.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Torpedo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Torpedo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Transplanter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>A tractor-towed implement that digs a channel and drops seedlings into the ground at worker stations; uncommon outside the Connecticut River Valley.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Transplanter</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Transplanter</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Trim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>filete</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The ornamental elements that embellish the edges of cigar boxes.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Trim</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Trim</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Triple%20Cap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>mounted head</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:definition>A cap with three seams; a Cuban style of finishing the head, now also used in Nicaragua, Honduras, and sometimes the Dominican Republic.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Triple Cap</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
    <om:fullyQualifiedName>cigars.Cigar Production.Triple Cap</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Cap"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Trumpet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar shape whose fattest point is the foot, narrowing continually toward the head.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Trumpet</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Trumpet</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Trunk%20Pressed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>trunk-pressed</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>The most extreme method of pressing cigars into square shapes, using wooden slats between cigars for very sharp, squared-off edges; associated with the Padron Anniversary line.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Trunk Pressed</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Trunk Pressed</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tube">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Tubos</skos:altLabel>
    <skos:altLabel>tubo</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A glass or aluminum container for an individual cigar, protecting it in a pocket or suitcase; tubed cigars are often wrapped in cedar.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tube</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Tube</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tunneling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>Tunnelling</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A burn defect where the inner filler leaves burn faster than the wrapper, often when too much time passes between draws; rotate the cigar to avoid it.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tunneling</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Tunneling</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/V%20Cutter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>V-cut</skos:altLabel>
    <skos:altLabel>V-cutter</skos:altLabel>
    <skos:altLabel>cat's eye</skos:altLabel>
    <skos:altLabel>wedge cutter</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>A cutter that carves a V-shape into the head, drawing smoke from the top and bottom of the cigar and concentrating it on the palate.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>V Cutter</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.V Cutter</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Vega">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A tobacco plantation.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Vega</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Vega</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Vein">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:definition>The rib of a tobacco leaf that delivers nutrients; pronounced veins are undesirable on wrapper leaves.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Vein</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Anatomy.Vein</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Vertical%20Sampler">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>A sampler featuring numerous sizes of one single cigar blend — an opportunity to taste how different shapes present a blend.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Vertical Sampler</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Vertical Sampler</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Viso">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>The filler priming below Ligero and above Seco; less intense than Ligero, stronger than Seco.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Viso</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Viso</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Vista">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The inner portion of a cigar box lid, often adorned with the brand's logo or ornate artwork.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Vista</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Vista</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Vitola">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <rdfs:subClassOf rdf:nodeID="b0"/>
    <rdfs:subClassOf rdf:nodeID="b4"/>
    <skos:altLabel>frontmark</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:definition>A cigar's shape or size; Robusto, Churchill, Toro, and Corona are all vitolas.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Vitola</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Vitolas.Vitola</om:fullyQualifiedName>
  </rdf:Description>
