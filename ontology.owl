  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Sucker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>suckers</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>An unwanted shoot removed from tobacco plants by workers so nutrients reach the leaves.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Sucker</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Sucker</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Suggested%20Retail%20Price">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>MSRP</skos:altLabel>
    <skos:altLabel>Manufacturer's Suggested Retail Price</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The price a manufacturer or distributor charges for a cigar; federal excise tax is often included, but state and local taxes are not, so prices vary by state.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Suggested Retail Price</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Suggested Retail Price</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Sun%20Grown">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:definition>Tobacco grown in direct sunlight, yielding thicker leaves with stronger veins; fuller and stronger than shade grown; all filler tobacco is sun grown.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Sun Grown</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Oscuro"/>
    <om:fullyQualifiedName>cigars.Tobacco Cultivation.Sun Grown</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Oscuro"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Sweet%20Spot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The portion of a cigar that tastes best — where flavor and strength harmonize perfectly on the palate; different for every cigar and smoker.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Sweet Spot</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Sweet Spot</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tabaquero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:definition>The Cuban term for a tobacco grower.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tabaquero</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Culture and Commerce.Tabaquero</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tapaclavo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>The sticker that conceals the nail in the lid of a box of cigars.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tapaclavo</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Tapaclavo</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tercios">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:definition>Tobacco bales wrapped in palm bark, used to age fermented tobacco.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tercios</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Curing and Fermentation.Tercios</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Thirteen%20Toppers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:definition>A rectangular box format with 12 cigars plus a space holder on the bottom row and 13 on top, usually sealed with a brass nail.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Thirteen Toppers</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Cigar Packaging.Thirteen Toppers</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Toasting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>The process of slowly warming the foot of a cigar with a flame before lighting it, to ensure an even burn.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Toasting</skos:prefLabel>
    <skos:related rdf:resource="http://localhost:8000/ontology/cigars/Foot"/>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Toasting</om:fullyQualifiedName>
    <om:relatedTo rdf:resource="http://localhost:8000/ontology/cigars/Foot"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tobacco%20Beetle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:altLabel>beetle</skos:altLabel>
    <skos:broader rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:definition>Lasioderma serricorne: a 2-3 millimeter beetle that hatches when the humidor temperature exceeds 72 degrees and ruins cigars with tiny pin-sized holes.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:prefLabel>Tobacco Beetle</skos:prefLabel>
    <om:fullyQualifiedName>cigars.Storage and Smoking.Tobacco Beetle</om:fullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://open-metadata.org/ontology/GlossaryTerm"/>
    <skos:definition>Growing tobacco: seeds, seedlings, primings, shade versus sun growing, and harvesting.</skos:definition>
    <skos:inScheme rdf:resource="https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Blue%20Mold"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Cheesecloth"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Encallado"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Hybrid"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Libre%20de%20Pie"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Ligero"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Medio%20Tiempo"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Nicotiana%20Tabacum"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Pelletized"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Primings"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Seco"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Seedbed"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Seedling"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Shade%20Grown"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Stalk%20Cut"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Sucker"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Sun%20Grown"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Seed"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Topping"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Transplanter"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Viso"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Volado"/>
    <skos:narrower rdf:resource="http://localhost:8000/ontology/cigars/Wilting"/>
