    <rdf:type rdf:resource="https://open-metadata.org/ontology/Glossary"/>
    <rdfs:label>Cigars</rdfs:label>
    <skos:definition>Semantic model of the cigar domain: controlled vocabulary of cigar terms harvested from the Holt's Cigar Company glossary (https://www.holts.com/clubhouse/cigar-101/glossary-of-terms), covering anatomy, vitolas, wrapper colors, cultivation, curing and fermentation, rolling and factory, packaging, storage and smoking, and culture and commerce.</skos:definition>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Anatomy"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Culture%20and%20Commerce"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Packaging"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Cigar%20Production"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Curing%20and%20Fermentation"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Tobaccos%20and%20Origins"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Vitolas"/>
    <skos:hasTopConcept rdf:resource="http://localhost:8000/ontology/cigars/Wrapper%20Colors"/>
    <om:fullyQualifiedName>cigars</om:fullyQualifiedName>
  </rdf:Description>
