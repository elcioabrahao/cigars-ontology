@prefix ns1: <http://qudt.org/schema/qudt/> .
@prefix om: <https://open-metadata.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cigars:Aging.months a owl:DatatypeProperty ;
    rdfs:label "months" ;
    ns1:unit "month" ;
    rdfs:comment "Duration of aging, in months." ;
    rdfs:domain cigars:Aging ;
    rdfs:range xsd:integer .

skos:altLabel a owl:AnnotationProperty .

skos:broader a owl:ObjectProperty .

skos:closeMatch a owl:ObjectProperty .

skos:definition a owl:AnnotationProperty .

skos:exactMatch a owl:ObjectProperty .

skos:hasTopConcept a owl:ObjectProperty .

skos:inScheme a owl:ObjectProperty .

skos:narrower a owl:ObjectProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:related a owl:ObjectProperty .

skos:relatedMatch a owl:ObjectProperty .

skos:topConceptOf a owl:ObjectProperty .

om:fullyQualifiedName a owl:DatatypeProperty .

cigars:A%20Size a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "A" ;
    skos:broader cigars:Vitolas ;
    skos:definition "Among the largest standard cigar sizes, traditionally 9.25 inches by a 47 ring gauge; 'A' cigars can burn for as much as two hours." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "A Size" ;
    om:fullyQualifiedName "cigars.Vitolas.A Size" .

cigars:Accordion%20Method a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "A rolling method in which the leaves are folded in a zig-zag shape like an accordion's bellows; faster than entubado, slower than booking." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Accordion Method" ;
    om:fullyQualifiedName "cigars.Cigar Production.Accordion Method" .

cigars:Active%20Humidification%20System a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "An electric or battery-powered device that expels and circulates humidity; typically used in larger humidors or cabinets." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Active Humidification System" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Active Humidification System" .

cigars:Amarillo a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Wrapper%20Colors ;
    skos:definition "A yellow cigar wrapper." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Amarillo" ;
    om:fullyQualifiedName "cigars.Wrapper Colors.Amarillo" .

cigars:Ammonia a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "Present in freshly harvested tobacco leaves; proper curing and fermentation rid the leaves of it, and improperly aged cigars deliver a harsh, bitter taste from it." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Ammonia" ;
    om:fullyQualifiedName "cigars.Curing and Fermentation.Ammonia" .

cigars:Arapiraca a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Tobaccos%20and%20Origins ;
    skos:definition "A tobacco with dark, oily leaves grown in the northeastern coastal region of Brazil; its seeds are also grown in Ecuador." ;
    skos:exactMatch <http://www.wikidata.org/entity/Q626175> ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Arapiraca" ;
    om:fullyQualifiedName "cigars.Tobaccos and Origins.Arapiraca" .

cigars:Aroma a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "bouquet",
        "room note" ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "The scent of a cigar, lit or unlit, as perceived by the olfactory senses." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Aroma" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Aroma" .

cigars:Aroma%20Wheel a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "A categorization tool used to describe and identify the different scents and flavor nuances in cigars, ranging from woody and spicy to floral and sweet." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Aroma Wheel" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Aroma Wheel" .

cigars:Ash a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "Stack" ;
    skos:broader cigars:Cigar%20Anatomy ;
    skos:definition "The burnt end of a lit cigar; its color (white, grey, black) reflects soil minerals such as magnesium." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Ash" ;
    om:fullyQualifiedName "cigars.Cigar Anatomy.Ash" .

cigars:Bale a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "A compressed, wrapped unit of storage for cured and fermented tobacco — often 100 pounds or more, aged for years or even decades." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bale" ;
    om:fullyQualifiedName "cigars.Curing and Fermentation.Bale" .

cigars:Band a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "anilla" ;
    skos:broader cigars:Cigar%20Anatomy ;
    skos:definition "The often colorful ring of paper around the head of a cigar identifying the brand and country of origin, often with intricate lithography." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Band" ;
    om:fullyQualifiedName "cigars.Cigar Anatomy.Band" .

cigars:Belicoso a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Vitolas ;
    skos:definition "A cigar shape similar to a Torpedo but shorter, with a more abrupt taper at the head." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Belicoso" ;
    om:fullyQualifiedName "cigars.Vitolas.Belicoso" .

cigars:Bethune a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Culture%20and%20Commerce ;
    skos:definition "A recipe of herbs, wine, rum, or liqueurs used to infuse tobaccos." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bethune" ;
    om:fullyQualifiedName "cigars.Cigar Culture and Commerce.Bethune" .

cigars:Binder a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "banda",
        "capote" ;
    skos:broader cigars:Cigar%20Anatomy ;
    skos:definition "The leaf that holds the filler leaves together inside a cigar; often a wrapper-grade leaf downgraded for cosmetic imperfections; with the filler it forms the bunch." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Binder" ;
    om:fullyQualifiedName "cigars.Cigar Anatomy.Binder" .

cigars:Bleeding a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "purging (lighter)" ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "Releasing an unwanted pocket of air from a butane lighter's fuel tank so a full injection of fresh fuel can occupy it; also called purging a lighter." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bleeding" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Bleeding" .

cigars:Bleeding%20the%20Lighter a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "The practice of releasing trapped air and old butane from a jet-flame lighter before refilling, to ensure a cleaner, more efficient flame." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bleeding the Lighter" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Bleeding the Lighter" .

cigars:Blind%20Taste a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "The process of smoking a cigar after its band has been removed, with no knowledge of the brand or blend." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Blind Taste" ;
    om:fullyQualifiedName "cigars.Cigar Production.Blind Taste" .

cigars:Blowout%20Bin a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Culture%20and%20Commerce ;
    skos:definition "The clearance aisle or shelf, physical or online, for cigars marked down to the lowest possible prices; a buzz word for bargain hunters." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Blowout Bin" ;
    om:fullyQualifiedName "cigars.Cigar Culture and Commerce.Blowout Bin" .

cigars:Blue%20Mold a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Tobacco%20Cultivation ;
    skos:definition "An airborne fungus (peronospora tabacina) that can infect and ruin an entire tobacco field in days; it has impacted every major growing region." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Blue Mold" ;
    om:fullyQualifiedName "cigars.Tobacco Cultivation.Blue Mold" .

cigars:Bofeton a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Packaging ;
    skos:definition "The layer of paper or film that folds protectively over the cigars inside a dress box, typically featuring the brand's logo." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bofeton" ;
    om:fullyQualifiedName "cigars.Cigar Packaging.Bofeton" .

cigars:Boite%20Nature a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Packaging ;
    skos:definition "The formally styled cedar cigar box: two hinges, a clasp, dovetailed joints, and four lifted cedar collars forming an inner lip." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Boite Nature" ;
    om:fullyQualifiedName "cigars.Cigar Packaging.Boite Nature" .

cigars:Bonao a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Tobaccos%20and%20Origins ;
    skos:definition "An agricultural region of the Dominican Republic, roughly an hour from Santiago, where Fuente Fuente Opus X's Cuban-seed shade tobaccos were first harvested." ;
    skos:exactMatch <http://www.wikidata.org/entity/Q2306136> ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bonao" ;
    om:fullyQualifiedName "cigars.Tobaccos and Origins.Bonao" .

cigars:Booking a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "A rolling method in which filler leaves are layered on top of one another like pages of a book and rolled up in a scroll; quick, but can create draw issues." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Booking" ;
    om:fullyQualifiedName "cigars.Cigar Production.Booking" .

cigars:Boutique a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Culture%20and%20Commerce ;
    skos:definition "A term once used for small-batch releases from makers outside the mainstream; overuse has eroded it as a romantic classification." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Boutique" ;
    om:fullyQualifiedName "cigars.Cigar Culture and Commerce.Boutique" .

cigars:Box a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Packaging ;
    skos:definition "The traditional cigar package, widely credited to H. Upmann in the early 1800s; US law since 1865 requires wooden boxes in counts of 25, 50, 100, or 250; Spanish cedar is the most common material." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Box" ;
    om:fullyQualifiedName "cigars.Cigar Packaging.Box" .

cigars:Box%20Code.code a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "code" ;
    rdfs:comment "The factory box code printed on the box." ;
    rdfs:domain cigars:Box%20Code ;
    rdfs:range xsd:string .

cigars:Box%20Pressed a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Vitolas ;
    skos:definition "A cigar with a flat, somewhat squared shape resulting from tight packing in a box with a flat top; degrees vary." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Box Pressed" ;
    om:fullyQualifiedName "cigars.Vitolas.Box Pressed" .

cigars:Brooch a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Packaging ;
    skos:definition "The clasp that fastens the top of a cigar box lid to the bottom." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Brooch" ;
    om:fullyQualifiedName "cigars.Cigar Packaging.Brooch" .

cigars:Brother%20Of%20The%20Leaf a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "BOTL" ;
    skos:broader cigars:Cigar%20Culture%20and%20Commerce ;
    skos:definition "A popular contemporary term identifying a fellow cigar lover; usage has blossomed across the Internet." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Brother Of The Leaf" ;
    om:fullyQualifiedName "cigars.Cigar Culture and Commerce.Brother Of The Leaf" .

cigars:Buckeye a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Culture%20and%20Commerce ;
    skos:definition "A small US cigar factory from before the Cuban Revolution; the term originates from Ohio-grown tobacco, the Buckeye State." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Buckeye" ;
    om:fullyQualifiedName "cigars.Cigar Culture and Commerce.Buckeye" .

cigars:Bunch a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "bonche" ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "The combination of binder and filler leaves, placed in a mold and then finished with a wrapper leaf." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bunch" ;
    om:fullyQualifiedName "cigars.Cigar Production.Bunch" .

cigars:Buncher a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "boncheros",
        "bunchers" ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "The factory worker who specializes in assembling the binder and filler leaves; distinct from the roller in many factories." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Buncher" ;
    om:fullyQualifiedName "cigars.Cigar Production.Buncher" .

cigars:Bunching%20Machine a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "Lieberman",
        "Temsco" ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "A hand-powered machine with a leather pad, guides, and a metal lever that aids assembly of the bunch; common in the Dominican Republic, rare elsewhere, unknown in Cuba." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bunching Machine" ;
    om:fullyQualifiedName "cigars.Cigar Production.Bunching Machine" .

cigars:Bundle a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Packaging ;
    skos:definition "Cigars packaged wrapped in cellophane instead of boxes, commonly in counts of 20 or 25; once for un-banded seconds, now also an economy premium format." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Bundle" ;
    om:fullyQualifiedName "cigars.Cigar Packaging.Bundle" .

cigars:Butane a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "A clean-burning, odorless fuel preferred for cigar lighters; fuel refined at least five times is strongly recommended." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Butane" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Butane" .

cigars:Calfrisa a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "A climate-controlled curing barn delivering precise humidity and temperature through interior ductwork; uncommon due to expense and construction." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Calfrisa" ;
    om:fullyQualifiedName "cigars.Curing and Fermentation.Calfrisa" .

cigars:Canoeing a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "A burn defect where one portion of the cigar burns hotter and faster than the other; sometimes remedied by touching up the burn with a lighter." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Canoeing" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Canoeing" .

cigars:Carbon a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "Charcoal (Spanish) used to raise the temperature in tobacco-curing barns; many operations now use propane heaters." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Carbon" ;
    om:fullyQualifiedName "cigars.Curing and Fermentation.Carbon" .

cigars:Carotene a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "A plant pigment that replaces chlorophyll in tobacco as the chlorophyll naturally breaks down." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Carotene" ;
    om:fullyQualifiedName "cigars.Curing and Fermentation.Carotene" .

cigars:Casing a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "case" ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "Re-moisturizing aged tobacco so it can be worked with, by dipping in water, misting, or high-humidity storage; also a term for flavoring pipe tobacco." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Casing" ;
    om:fullyQualifiedName "cigars.Curing and Fermentation.Casing" .

cigars:Chaveta a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Production ;
    skos:definition "The flat piece of steel with a curved end that a cigar roller uses to trim a wrapper leaf to the correct size." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Chaveta" ;
    om:fullyQualifiedName "cigars.Cigar Production.Chaveta" .

cigars:Cheesecloth a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Tobacco%20Cultivation ;
    skos:definition "The material once used to cover shade-grown tobacco fields; today replaced by nylon." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Cheesecloth" ;
    om:fullyQualifiedName "cigars.Tobacco Cultivation.Cheesecloth" .

cigars:Cheroot a owl:Class,
