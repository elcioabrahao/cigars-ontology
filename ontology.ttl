        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "beetle" ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "Lasioderma serricorne: a 2-3 millimeter beetle that hatches when the humidor temperature exceeds 72 degrees and ruins cigars with tiny pin-sized holes." ;
