cigars:Fermentation a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "The process after curing and before aging in which bulks of leaves release ammonia and other impurities under natural heat (up to 140 degrees Fahrenheit) and pressure; can take several months or longer." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
