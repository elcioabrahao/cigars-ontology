cigars:Aging a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "Ageing" ;
    skos:broader cigars:Curing%20and%20Fermentation ;
    skos:definition "The process of allowing tobacco to rest under precisely monitored conditions whereby unwanted impurities dissipate; applied to whole leaves in bales and to finished cigars, for months or several years." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
