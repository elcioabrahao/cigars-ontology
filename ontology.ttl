        om:GlossaryTerm ;
    skos:altLabel "cedar" ;
    skos:broader cigars:Cigar%20Packaging ;
    skos:definition "Cedrela, a mahogany-family tree harvested in tropical regions; ideal for cigar boxes and humidors because it reacts positively with moisture and benefits aging; also a tasting note." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
