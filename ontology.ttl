    om:fullyQualifiedName "cigars.Tobacco Cultivation.Tobacco Seed" .

cigars:Tobacco%20Sorting a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Production ;
