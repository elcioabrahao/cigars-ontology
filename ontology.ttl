cigars:Tunneling a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "Tunnelling" ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "A burn defect where the inner filler leaves burn faster than the wrapper, often when too much time passes between draws; rotate the cigar to avoid it." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Tunneling" ;
    om:fullyQualifiedName "cigars.Storage and Smoking.Tunneling" .

cigars:V%20Cutter a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "V-cut",
        "V-cutter",
        "cat's eye",
        "wedge cutter" ;
    skos:broader cigars:Storage%20and%20Smoking ;
