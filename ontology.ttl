        om:GlossaryTerm ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "The process of slowly warming the foot of a cigar with a flame before lighting it, to ensure an even burn." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
