        om:GlossaryTerm ;
    skos:altLabel "Plug" ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "Having an obstructed draw; a piercer can sometimes loosen the tobacco, otherwise the cigar is unsmokable." ;
