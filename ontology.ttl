        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Tobacco%20Cultivation ;
    skos:definition "Tobacco grown in direct sunlight, yielding thicker leaves with stronger veins; fuller and stronger than shade grown; all filler tobacco is sun grown." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
