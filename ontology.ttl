cigars:Primings a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Tobacco%20Cultivation ;
    skos:definition "The vertical stations of a tobacco plant, harvested bottom-up a few leaves at a time; from bottom: Volado, Seco, Viso, Ligero; leaves strengthen with height and sunlight." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
