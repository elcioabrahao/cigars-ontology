    skos:prefLabel "Tobacco Sorting" ;
    om:fullyQualifiedName "cigars.Cigar Production.Tobacco Sorting" .

cigars:Top%2025 a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
    skos:broader cigars:Cigar%20Culture%20and%20Commerce ;
    skos:definition "Cigar Aficionado's annual Top 25 Cigars of the Year list, announced at the end of the year." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
    skos:prefLabel "Top 25" ;
    om:fullyQualifiedName "cigars.Cigar Culture and Commerce.Top 25" .

cigars:Topping a owl:Class,
        skos:Concept,
        om:GlossaryTerm ;
