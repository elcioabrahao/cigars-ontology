        skos:Concept,
        om:GlossaryTerm ;
    skos:altLabel "Tobacco Seeds" ;
    skos:broader cigars:Tobacco%20Cultivation ;
    skos:definition "The tiny origin of the tobacco plant; often pelletized in clay for handling, with farmers collecting seeds from prized plants for future crops." ;
