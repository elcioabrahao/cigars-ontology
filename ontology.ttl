        om:GlossaryTerm ;
    skos:broader cigars:Tobaccos%20and%20Origins ;
    skos:definition "Spanish for 'cigar'; specifically a cigar whose binder, filler, and wrapper tobaccos are all grown in one nation." ;
    skos:inScheme <https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0> ;
