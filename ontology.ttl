            owl:onProperty cigars:Smoking%20Time.minutes ] ;
    skos:broader cigars:Storage%20and%20Smoking ;
    skos:definition "The duration a cigar burns: roughly 30 minutes for a 5x50 Robusto, over an hour for a 7.5x52 Double Corona; thinner cigars burn hotter and faster." ;
