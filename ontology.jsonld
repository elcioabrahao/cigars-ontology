    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@value": "purging (lighter)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "http://localhost:8000/ontology/cigars/Storage%20and%20Smoking"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Releasing an unwanted pocket of air from a butane lighter's fuel tank so a full injection of fresh fuel can occupy it; also called purging a lighter."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"
