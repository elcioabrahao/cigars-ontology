      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A rolling method in which the leaves are folded in a zig-zag shape like an accordion's bellows; faster than entubado, slower than booking."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
