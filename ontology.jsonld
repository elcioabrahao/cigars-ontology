    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Present in freshly harvested tobacco leaves; proper curing and fermentation rid the leaves of it, and improperly aged cigars deliver a harsh, bitter taste from it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
