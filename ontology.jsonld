    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A cigar shape measuring 6 to 7 inches by a 42 to 44 ring gauge; longer than a Corona, not as thin as a Panetela."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
