    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Harmless small white powdery dots, from crystallized natural oils, that appear on an aging cigar's wrapper — a sign of proper aging; not to be confused with harmful blue/green mold."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
