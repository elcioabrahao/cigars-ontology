    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The complete recipe of tobaccos in a premium cigar: up to five filler leaves, one or two binder leaves, and the exterior wrapper; precise ingredients are rarely revealed."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
