      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The practice of releasing trapped air and old butane from a jet-flame lighter before refilling, to ensure a cleaner, more efficient flame."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://open-metadata.org/entity/glossary/2d4821f6-6d17-46e9-b5b6-b5af8b6068c0"
      }
    ],
