    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Cigars made by machine rather than by hand, using short-filler and homogenized tobacco; manufactured in far greater quantities than premium cigars."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
