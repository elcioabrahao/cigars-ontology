      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The two-part wood or plastic form, joined under pressure, that conforms the bunch to the cigar shape being made; the word also names the harmful blue or green fungus that develops on cigars stored too warm — such cigars must be discarded."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
