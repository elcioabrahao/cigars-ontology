        "@id": "http://localhost:8000/ontology/cigars/Tobacco%20Cultivation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The small leaves that grow at the very top of the plant; prized by cigar-makers for complex, intense flavor from maximum direct sunlight."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
