      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "A rolling method in which filler leaves are layered on top of one another like pages of a book and rolled up in a scroll; quick, but can create draw issues."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
