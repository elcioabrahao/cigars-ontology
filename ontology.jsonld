      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Spanish for 'ripe': a very dark brown or nearly black wrapper, achieved through sun exposure or extended fermentation that brings sugars to the leaf surface."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
