    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "An additional fermentation step for tobacco from the periphery of a pilon, exposed to about 100 degrees Fahrenheit and 90% RH in a mulling room for a more complete fermentation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
